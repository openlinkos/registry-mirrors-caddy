# 复制为 .env 后按需修改：cp .env.sample .env

# 运行模式：
#   tls   直接对外（默认）。Caddy 监听 80、443，为五个子域名自动申请证书。
#   vhost 放在 CDN 或反向代理之后。Caddy 只监听一个明文端口 HTTP_PORT，按访问的域名区分上游，由前面负责 TLS。
#   http  放在 CDN 或反向代理之后，每个上游一个明文端口 5001–5005，由前面负责 TLS。
# vhost、http 模式回源时都要保留客户端访问的域名（Host 头）：上游的认证地址据此改写成本站地址。
MODE=tls

# tls、vhost 模式：你的域名。五个子域名 docker、gcr、ghcr、k8s、quay.<DOMAIN>。
# tls 模式要把它们解析到本机。
DOMAIN=example.com

# tls 模式：证书验证方式。
#   auto        HTTP-01 / TLS-ALPN-01（默认），需要 80、443 端口能从公网访问
#   cloudflare  DNS-01，需要 CLOUDFLARE_API_TOKEN（Zone.DNS 编辑权限）
#   dnspod      DNS-01，需要 DNSPOD_TOKEN（格式：ID,Token）
# 后两种需要带 DNS 插件的镜像：docker build -t registry-mirrors-caddy:2.11.7 .，并设置 CADDY_IMAGE。
ACME_DNS=auto
# CADDY_IMAGE=registry-mirrors-caddy:2.11.7
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# DNSPOD_TOKEN=your-dnspod-id,your-dnspod-token

# vhost、http 模式：客户端访问时使用的协议。CDN 或反向代理终止 TLS 时为 https；本地明文测试时设为 http。
PUBLIC_SCHEME=https

# vhost 模式的明文端口。
# HTTP_PORT=8080

# http 模式的端口，默认 5001–5005 依次对应 Docker Hub、gcr.io、ghcr.io、registry.k8s.io、quay.io。
# PORT_DOCKER=5001
# PORT_GCR=5002
# PORT_GHCR=5003
# PORT_K8S=5004
# PORT_QUAY=5005

# 监听地址。留空表示所有地址；反向代理与本服务在同一台机器上时可设为 127.0.0.1。
BIND=

# 信任这些地址发来的 X-Forwarded-For，用于在访问日志中记录真实客户端 IP（从右往左取第一个不受信任的地址）。
# 放在 CDN 之后时改为 CDN 的回源地址段（空格分隔）。
TRUSTED_PROXIES=private_ranges
